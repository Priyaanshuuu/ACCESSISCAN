generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
}

enum UserPlan {
  FREE
  INDIE
  BUSINESS
  AGENCY
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

model Scan {
  id          String     @id
  url         String
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  siteId      String?
  site        Site?      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  status      ScanStatus @default(QUEUED)
  finalUrl    String?
  pageTitle   String?
  httpStatus  Int?
  durationMs  Int?
  overallScore Int?
  performanceScore Int?
  seoScore         Int?
  bestPracticesScore Int?
  lighthouseMetrics Json?
  lighthouseAudits  Json?
  lighthouseError   String?
  failureReason     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?
  issues      Issue[]
  pages       ScanPage[]
  maxPages    Int        @default(1)
  maxDepth    Int        @default(0)

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@index([siteId])
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scans     Scan[]
  sites     Site[]
  schedules ScheduledScan[]
  notificationPreferences NotificationPreference?
  usagePeriods UsagePeriod[]
  plan      UserPlan @default(FREE)
  payments  Payment[]
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String        @default("razorpay")
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  plan              UserPlan
  amountPaise       Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId, status])
}

model UsagePeriod {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period    String
  scanCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, period])
  @@index([userId])
}

model Site {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scans     Scan[]
  schedules ScheduledScan[]

  @@unique([userId, url])
  @@index([userId])
}

model ScheduledScan {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  frequency ScheduleFrequency
  enabled   Boolean           @default(true)
  nextRunAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([enabled, nextRunAt])
  @@index([userId])
  @@unique([userId, siteId])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled       Boolean  @default(true)
  notifyOnRegression Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Issue {
  id          String   @id @default(cuid())
  scanId      String
  scan        Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  rule        String
  impact      String?
  severity    String   @default("info")
  description String
  help        String
  helpUrl     String
  html        String?
  targets     Json
  tags        Json
  fix         String?
  recommendation String?
  createdAt   DateTime @default(now())

  @@index([scanId])
  @@index([impact])
}

model ScanPage {
  id         String   @id @default(cuid())
  scanId     String
  scan       Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  url        String
  depth      Int
  status     String
  issueCount Int      @default(0)
  mobileIssueCount Int @default(0)
  touchTargetCount Int @default(0)
  hasHorizontalOverflow Boolean @default(false)
  hasViewportMeta Boolean @default(false)
  createdAt  DateTime @default(now())

  @@unique([scanId, url])
  @@index([scanId])
}