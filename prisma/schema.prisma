generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model Scan {
  id          String     @id
  url         String
  status      ScanStatus @default(QUEUED)
  finalUrl    String?
  pageTitle   String?
  httpStatus  Int?
  durationMs  Int?
  overallScore Int?
  performanceScore Int?
  seoScore         Int?
  bestPracticesScore Int?
  lighthouseMetrics Json?
  lighthouseAudits  Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?
  issues      Issue[]

  @@index([createdAt])
  @@index([status])
}

model Issue {
  id          String   @id @default(cuid())
  scanId      String
  scan        Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  rule        String
  impact      String?
  severity    String   @default("info")
  description String
  help        String
  helpUrl     String
  html        String?
  targets     Json
  tags        Json
  fix         String?
  recommendation String?
  createdAt   DateTime @default(now())

  @@index([scanId])
  @@index([impact])
}